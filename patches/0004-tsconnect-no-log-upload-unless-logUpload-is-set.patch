From 156d0fea34296862bb59bc116d0c74e8221c4b9e Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Fri, 9 Oct 2026 17:09:43 +0200
Subject: [PATCH] tsconnect: no log upload unless logUpload is set

---
 cmd/tsconnect/wasm/wasm_js.go | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/cmd/tsconnect/wasm/wasm_js.go b/cmd/tsconnect/wasm/wasm_js.go
index 42829fdb8..730c5f20e 100644
--- a/cmd/tsconnect/wasm/wasm_js.go
+++ b/cmd/tsconnect/wasm/wasm_js.go
@@ -109,8 +109,10 @@ func newIPN(jsConfig js.Value) map[string]any {
 
 		HTTPC: &http.Client{Transport: &noCORSTransport{http.DefaultTransport}},
 	}
-	logtail := logtail.NewLogger(c, log.Printf)
-	logf := logtail.Logf
+	var logf func(format string, args ...any) = log.Printf
+	if jsLogUpload := jsConfig.Get("logUpload"); jsLogUpload.Type() == js.TypeBoolean && jsLogUpload.Bool() {
+		logf = logtail.NewLogger(c, log.Printf).Logf
+	}
 
 	sys := tsd.NewSystem()
 	sys.Set(store)
-- 
