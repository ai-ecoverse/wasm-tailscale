From 697b4fb54a068fbd07c96b78411b631cac6ac91f Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Fri, 9 Oct 2026 14:42:11 +0200
Subject: [PATCH 2/4] tsconnect: shields up by default, login with an auth key
 pasted after start, shieldsUp in status

---
 cmd/tsconnect/wasm/slicc_js.go | 16 ++++++++++++++++
 cmd/tsconnect/wasm/wasm_js.go  |  5 +++--
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/cmd/tsconnect/wasm/slicc_js.go b/cmd/tsconnect/wasm/slicc_js.go
index 0740d8f96..51ec78bf8 100644
--- a/cmd/tsconnect/wasm/slicc_js.go
+++ b/cmd/tsconnect/wasm/slicc_js.go
@@ -13,6 +13,7 @@
 	"encoding/json"
 	"errors"
 	"io"
+	"log"
 	"net"
 	"net/http"
 	"net/netip"
@@ -375,6 +376,7 @@ type jsStatus struct {
 	MagicDNS     string         `json:"magicDNSSuffix,omitempty"`
 	ExitNode     *jsPeerStatus  `json:"exitNode,omitempty"`
 	AutoExitNode string         `json:"autoExitNode,omitempty"`
+	ShieldsUp    bool           `json:"shieldsUp"`
 	Peers        []jsPeerStatus `json:"peers"`
 }
 
@@ -408,7 +410,21 @@ func (i *jsIPN) status() string {
 	}
 	if prefs := i.lb.Prefs(); prefs.Valid() {
 		out.AutoExitNode = string(prefs.AutoExitNode())
+		out.ShieldsUp = prefs.ShieldsUp()
 	}
 	b, _ := json.Marshal(out)
 	return string(b)
 }
+
+// loginWithKey starts the backend again with an auth key that arrived after
+// newIPN (pasted by the user), then logs in with it. The key is only held in
+// memory, as an option of this one Start.
+func (i *jsIPN) loginWithKey(authKey string) {
+	go func() {
+		if err := i.lb.Start(ipn.Options{AuthKey: authKey}); err != nil {
+			log.Printf("Start with auth key: %v", err)
+			return
+		}
+		i.lb.StartLoginInteractive(context.Background())
+	}()
+}
diff --git a/cmd/tsconnect/wasm/wasm_js.go b/cmd/tsconnect/wasm/wasm_js.go
index 1b02f0322..42829fdb8 100644
--- a/cmd/tsconnect/wasm/wasm_js.go
+++ b/cmd/tsconnect/wasm/wasm_js.go
@@ -200,8 +200,8 @@ func newIPN(jsConfig js.Value) map[string]any {
 			return nil
 		}),
 		"login": js.FuncOf(func(this js.Value, args []js.Value) any {
-			if len(args) != 0 {
-				log.Printf("Usage: login()")
+			if len(args) == 1 && args[0].Type() == js.TypeString {
+				jsIPN.loginWithKey(args[0].String())
 				return nil
 			}
 			jsIPN.login()
@@ -363,6 +363,7 @@ func (i *jsIPN) run(jsCallbacks js.Value) {
 		prefs := &ipn.Prefs{
 			ControlURL:  i.controlURL,
 			RouteAll:    true,
+			ShieldsUp:   true,
 			WantRunning: true,
 			Hostname:    i.hostname,
 		}
-- 
